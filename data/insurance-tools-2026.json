    "outputs": [
      {
        "key": "incomeReplacementNeed",
        "label": "Income replacement need",
        "formula": "annualIncome*replacementYears",
        "format": "currency"
      },
      {
        "key": "grossCoverNeed",
        "label": "Total cover need",
        "formula": "incomeReplacementNeed+outstandingLiabilities+dependentGoals",
        "format": "currency"
      },
      {
        "key": "additionalCoverNeeded",
        "label": "Additional cover needed",
        "formula": "max(grossCoverNeed-existingLifeCover,0)",
        "format": "currency"
      },
      {
        "key": "existingCoverShare",
