  {
    "slug": "credit-card-minimum-due-trap-calculator-india",
    "name": "Credit Card Minimum-Due Trap Calculator India",
    "seoTitle": "Credit Card Minimum Due Calculator India | Payoff Trap",
    "category": "Debt",
    "status": "live",
    "targetKeyword": "credit card minimum due calculator India",
    "shortDescription": "Estimate payoff months and interest when repaying a credit-card balance with the first minimum due or a fixed monthly payment.",
    "metaDescription": "See how long credit card debt may take to clear in India using balance, minimum due, APR and a fixed monthly payment.",
    "inputs": [
      {
        "key": "outstandingBalance",
        "label": "Outstanding card balance",
        "unit": "Rs",
        "default": 200000,
        "min": 1,
        "step": 1000
      },
      {
        "key": "minimumDuePercent",
        "label": "Minimum due",
        "unit": "%",
        "default": 5,
        "min": 1,
        "max": 25,
        "step": 0.5
      },
      {
        "key": "cardApr",
        "label": "Credit card APR",
        "unit": "%",
        "default": 42,
        "min": 0.1,
        "max": 60,
        "step": 0.1
      },
      {
        "key": "fixedMonthlyPayment",
        "label": "Fixed monthly payment",
        "unit": "Rs",
        "default": 15000,
        "min": 1,
        "step": 500
      }
    ],
    "outputs": [
      {
        "key": "monthlyRate",
        "label": "Monthly card rate",
        "formula": "cardApr/1200",
        "format": "percent",
        "hidden": true
      },
      {
        "key": "firstMinimumDue",
        "label": "First minimum due",
        "formula": "outstandingBalance*minimumDuePercent/100",
        "format": "currency"
      },
      {
        "key": "firstMonthInterest",
        "label": "First-month interest",
        "formula": "outstandingBalance*monthlyRate",
        "format": "currency"
      },
      {
        "key": "minimumDueMonths",
        "label": "Payoff months at first minimum due",
        "formula": "-log(1-outstandingBalance*monthlyRate/firstMinimumDue)/log(1+monthlyRate)",
        "format": "number"
      },
      {
        "key": "minimumDueTotalPayment",
        "label": "Total paid at first minimum due",
        "formula": "firstMinimumDue*minimumDueMonths",
        "format": "currency"
      },
      {
        "key": "minimumDueInterest",
        "label": "Interest at first minimum due",
        "formula": "max(minimumDueTotalPayment-outstandingBalance,0)",
        "format": "currency"
      },
      {
        "key": "fixedPaymentMonths",
        "label": "Payoff months at fixed payment",
        "formula": "-log(1-outstandingBalance*monthlyRate/fixedMonthlyPayment)/log(1+monthlyRate)",
        "format": "number"
      },
      {
        "key": "fixedTotalPayment",
        "label": "Total paid at fixed payment",
        "formula": "fixedMonthlyPayment*fixedPaymentMonths",
        "format": "currency"
      },
      {
        "key": "fixedPaymentInterest",
        "label": "Interest at fixed payment",
        "formula": "max(fixedTotalPayment-outstandingBalance,0)",
        "format": "currency"
      },
      {
        "key": "interestSaved",
        "label": "Interest saved with fixed payment",
        "formula": "minimumDueInterest-fixedPaymentInterest",
        "format": "currency"
      }
    ],
    "formulaExplanation": "Uses a reducing-balance amortisation approximation. The minimum-due scenario holds the first statement's minimum due constant; actual percentage-based minimums usually fall as the balance falls and can take longer.",
    "example": "On a Rs 2 lakh balance at 42% APR, paying Rs 15,000 monthly clears debt much sooner than holding payment at the first minimum due of Rs 10,000.",
    "faqs": [
      {
        "question": "Why is the minimum-due result an approximation?",
        "answer": "Card issuers calculate minimum due using their own rules, and the rupee amount often changes with balance, fees, taxes and new transactions."
      },
      {
        "question": "What if payment is lower than monthly interest?",
        "answer": "The balance will not amortise under this model. Increase the payment above monthly interest and avoid new card spending while repaying."
      }
    ],
