        "min": 1,
        "max": 3,
        "step": 1
      },
      {
        "key": "oldestAgeBand",
        "label": "Oldest age band (1 under 35, 2 age 35-50, 3 over 50)",
        "default": 2,
        "min": 1,
        "max": 3,
        "step": 1
      },
      {
        "key": "currentSumInsured",
        "label": "Current family sum insured",
        "unit": "Rs",
        "default": 1000000,
        "min": 0,
        "step": 50000
      },
      {
        "key": "medicalInflation",
        "label": "Estimated annual medical inflation",
        "unit": "%",
        "default": 10,
        "min": 0.1,
        "max": 25,
        "step": 0.5
      },
      {
        "key": "projectionYears",
        "label": "Projection period",
        "unit": "years",
        "default": 10,
        "min": 1,
        "max": 30,
        "step": 1
      }
    ],
    "outputs": [
      {
        "key": "cityCostFactor",
        "label": "City cost factor",
        "formula": "1.45-0.15*cityTier",
        "format": "number",
        "hidden": true
      },
      {
        "key": "ageCostFactor",
        "label": "Age cost factor",
        "formula": "0.75+0.25*oldestAgeBand",
        "format": "number",
        "hidden": true
      },
      {
        "key": "recommendedLowerToday",
        "label": "Illustrative lower cover today",
        "formula": "familySize*400000*cityCostFactor*ageCostFactor",
        "format": "currency"
      },
      {
        "key": "recommendedUpperToday",
        "label": "Illustrative upper cover today",
        "formula": "familySize*750000*cityCostFactor*ageCostFactor",
        "format": "currency"
      },
      {
        "key": "recommendedLowerFuture",
        "label": "Inflation-adjusted lower cover",
        "formula": "recommendedLowerToday*(1+medicalInflation/100)^projectionYears",
        "format": "currency"
      },
      {
        "key": "recommendedUpperFuture",
        "label": "Inflation-adjusted upper cover",
        "formula": "recommendedUpperToday*(1+medicalInflation/100)^projectionYears",
        "format": "currency"
      },
      {
        "key": "coverGapToday",
        "label": "Gap to lower cover today",
        "formula": "max(recommendedLowerToday-currentSumInsured,0)",
        "format": "currency"
      },
      {
        "key": "futureCoverGap",
        "label": "Gap to future lower cover",
        "formula": "max(recommendedLowerFuture-currentSumInsured,0)",
        "format": "currency"
      },
      {
        "key": "currentAdequacy",
        "label": "Current cover vs lower band",
        "formula": "currentSumInsured/max(recommendedLowerToday,1)*100",
        "format": "percent"
      }
    ],
    "formulaExplanation": "Builds an illustrative per-member cover band, applies simple city and oldest-member age factors, then compounds the band by entered medical inflation.",
    "example": "A four-person metro family with an oldest member aged 35-50 is compared with a higher illustrative band than a smaller family in a lower-cost city.",
    "faqs": [
      {
        "question": "Is this cover band an insurer rule?",
        "answer": "No. It is a planning benchmark, not underwriting guidance. Hospital network, room limits, exclusions, co-pay and restoration benefits also matter."
      },
      {
        "question": "Why project medical inflation?",
        "answer": "A sum insured that looks adequate today may buy less hospital care later as treatment costs rise."
      }
