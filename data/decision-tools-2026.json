        "key": "newMonthlyTakeHome",
        "label": "New monthly take-home estimate",
        "formula": "newAnnual*newTakeHomeRatio/100/12",
        "format": "currency"
      },
      {
        "key": "monthlyTakeHomeIncrease",
        "label": "Monthly take-home increase",
        "formula": "newMonthlyTakeHome-currentMonthlyTakeHome",
        "format": "currency"
      },
      {
        "key": "realHike",
        "label": "Inflation-adjusted hike",
        "formula": "((1+hikePercent/100)/(1+inflation/100)-1)*100",
        "format": "percent"
      }
    ],
