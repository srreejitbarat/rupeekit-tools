        "max": 300,
        "step": 0.5
      },
      {
        "key": "currentTakeHomeRatio",
        "label": "Current take-home ratio",
        "unit": "%",
        "default": 78,
        "min": 1,
        "max": 100,
        "step": 1
      },
      {
        "key": "newTakeHomeRatio",
        "label": "New take-home ratio",
        "unit": "%",
        "default": 75,
        "min": 1,
        "max": 100,
        "step": 1
      },
      {
        "key": "inflation",
        "label": "Inflation assumption",
        "unit": "%",
        "default": 5,
        "min": -10,
        "max": 30,
        "step": 0.1
      }
    ],
    "outputs": [
      {
        "key": "newAnnual",
        "label": "New annual salary",
        "formula": "currentAnnual*(1+hikePercent/100)",
        "format": "currency"
      },
      {
        "key": "annualIncrease",
        "label": "Annual gross increase",
        "formula": "newAnnual-currentAnnual",
        "format": "currency"
      },
      {
        "key": "monthlyGrossIncrease",
        "label": "Monthly gross increase",
        "formula": "annualIncrease/12",
        "format": "currency"
      },
      {
        "key": "currentMonthlyTakeHome",
        "label": "Current monthly take-home estimate",
        "formula": "currentAnnual*currentTakeHomeRatio/100/12",
