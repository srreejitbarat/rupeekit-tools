  {
    "slug": "rent-vs-buy-calculator-india",
    "name": "Rent vs Buy Calculator India",
    "seoTitle": "Rent vs Buy Calculator India 2026 | Compare Long-Term Cost",
    "category": "Housing",
    "status": "live",
    "targetKeyword": "rent vs buy calculator India",
    "shortDescription": "Compare renting with buying after loan interest, rent growth, home appreciation, maintenance and investing the down payment.",
    "metaDescription": "Compare rent vs buy in India using home price, loan, rent growth, appreciation, ownership costs and investment-return assumptions.",
    "inputs": [
      {
        "key": "homePrice",
        "label": "Home price",
        "unit": "Rs",
        "default": 8000000,
        "min": 100000,
        "step": 100000
      },
      {
        "key": "downPayment",
        "label": "Down payment",
        "unit": "Rs",
        "default": 1600000,
        "min": 0,
        "step": 50000
      },
      {
        "key": "loanRate",
        "label": "Home-loan rate",
        "unit": "%",
        "default": 8.5,
        "min": 0.1,
        "max": 30,
        "step": 0.1
      },
      {
        "key": "years",
        "label": "Comparison period",
        "unit": "years",
        "default": 20,
        "min": 1,
        "max": 30,
        "step": 1
      },
      {
        "key": "monthlyRent",
        "label": "Current monthly rent",
        "unit": "Rs",
        "default": 25000,
        "min": 0,
        "step": 1000
      },
      {
        "key": "rentGrowth",
        "label": "Annual rent increase",
        "unit": "%",
        "default": 6,
        "min": 0.1,
        "max": 20,
        "step": 0.1
      },
      {
        "key": "homeGrowth",
        "label": "Annual home appreciation",
        "unit": "%",
        "default": 5,
        "min": 0.1,
        "max": 20,
        "step": 0.1
      },
      {
        "key": "maintenanceRate",
        "label": "Annual ownership-cost rate",
        "unit": "%",
        "default": 1,
        "min": 0,
        "max": 10,
        "step": 0.1
      },
      {
        "key": "investmentReturn",
        "label": "Return on invested down payment",
        "unit": "%",
        "default": 10,
        "min": 0.1,
        "max": 30,
        "step": 0.1
      }
    ],
    "outputs": [
      {
        "key": "loanPrincipal",
        "label": "Loan amount",
        "formula": "max(homePrice-downPayment,0)",
        "format": "currency"
      },
      {
        "key": "months",
        "label": "Loan months",
        "formula": "years*12",
        "format": "number",
        "hidden": true
      },
      {
        "key": "monthlyRate",
        "label": "Monthly loan rate",
        "formula": "loanRate/1200",
        "format": "percent",
        "hidden": true
      },
      {
        "key": "emi",
        "label": "Monthly EMI",
        "formula": "loanPrincipal*monthlyRate*(1+monthlyRate)^months/((1+monthlyRate)^months-1)",
        "format": "currency"
      },
      {
        "key": "futureHomeValue",
        "label": "Estimated future home value",
        "formula": "homePrice*(1+homeGrowth/100)^years",
        "format": "currency"
      },
      {
        "key": "totalRent",
        "label": "Estimated total rent",
        "formula": "monthlyRent*12*((1+rentGrowth/100)^years-1)/(rentGrowth/100)",
        "format": "currency"
      },
      {
        "key": "ownershipCosts",
        "label": "Estimated ownership costs",
        "formula": "homePrice*maintenanceRate/100*((1+homeGrowth/100)^years-1)/(homeGrowth/100)",
        "format": "currency"
      },
      {
        "key": "investedDownPayment",
        "label": "Potential invested down-payment value",
        "formula": "downPayment*(1+investmentReturn/100)^years",
        "format": "currency"
      },
      {
        "key": "buyNetAsset",
        "label": "Buy-side net asset estimate",
        "formula": "futureHomeValue-(emi*months-loanPrincipal)-ownershipCosts",
        "format": "currency"
      },
      {
        "key": "rentNetAsset",
        "label": "Rent-side net asset estimate",
        "formula": "investedDownPayment-totalRent",
        "format": "currency"
      },
      {
        "key": "buyAdvantage",
        "label": "Buy-side advantage",
        "formula": "buyNetAsset-rentNetAsset",
        "format": "currency"
      }
    ],
    "formulaExplanation": "Calculates reducing-balance EMI, estimated rent, ownership costs, future home value and the opportunity cost of the down payment.",
    "example": "Small changes in appreciation and investment return can reverse the outcome.",
    "faqs": [
      {
        "question": "Does a positive result mean I should buy?",
        "answer": "No. It only means the entered assumptions favour buying mathematically."
      },
      {
        "question": "What if I don't know future home appreciation?",
        "answer": "Use a conservative rate for your city; the comparison is most reliable when appreciation and rent-growth assumptions are realistic rather than optimistic."
      }
    ],
