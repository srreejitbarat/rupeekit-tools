NEXT_PUBLIC_CONTACT_EMAIL="rupeekitofficial@gmail.com"
NEXT_PUBLIC_GA_ID=""
NEXT_PUBLIC_ADSENSE_CLIENT=""

# Google Search Console reporting pipeline
# Use the exact Search Console property identifier, for example:
# GSC_SITE_URL="sc-domain:rupeekit.co.in"
GSC_SITE_URL=""
GSC_CLIENT_EMAIL=""
# Paste the service-account private key with literal \n escapes when stored on one line.
GSC_PRIVATE_KEY=""

# Optional: include GA4 totals in the same report when the same service account
# has Viewer access to the GA4 property and Analytics Data API is enabled.
GA4_PROPERTY_ID=""

# Optional official-update email subscription channel (Buttondown).
# Server-side secret only. Never expose this as NEXT_PUBLIC_*.
BUTTONDOWN_API_KEY=""
